# ---------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard  ->  Project Settings -> API
# ONE vendor for all three: auth, Postgres, and realtime.
# Copy .env.example to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server-only. Bypasses Row Level Security — never expose it to the browser,
# never prefix it with NEXT_PUBLIC_. Used only by the admin chip-grant path
# after an admin check has already passed.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ---------------------------------------------------------------------------
# After creating the project, apply the schema:
#   supabase db push        (local CLI)
#   or paste supabase/schema.sql into the dashboard SQL editor
#
# Then in Authentication -> Sign In / Providers, decide whether email
# confirmation is required. Turn OFF "Confirm email" for local play-testing so
# you can register straight away; turn it ON before going live.
# ---------------------------------------------------------------------------